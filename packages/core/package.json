{
  "name": "@tiff-provider/core",
  "version": "0.3.2",
  "description": "Framework-agnostic in-browser TIFF→WebP transcoder: decoder, encoder, and a prebuilt Service Worker.",
  "keywords": [
    "tiff",
    "geotiff",
    "webp",
    "transcode",
    "decode",
    "image",
    "service-worker",
    "offscreencanvas",
    "utif",
    "browser"
  ],
  "author": "San Chen <bigsan.chen@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigsan/nuxt-tiff-provider.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bigsan/nuxt-tiff-provider/tree/main/packages/core#readme",
  "bugs": "https://github.com/bigsan/nuxt-tiff-provider/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./url": {
      "types": "./dist/url.d.ts",
      "import": {
        "types": "./dist/url.d.ts",
        "default": "./dist/url.js"
      },
      "require": {
        "types": "./dist/url.d.cts",
        "default": "./dist/url.cjs"
      }
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    },
    "./tiff-sw.js": "./dist/tiff-sw.js"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "geotiff": "^2.1.3",
    "ufo": "^1.5.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
