{
  "name": "nuxt-tiff-provider",
  "version": "0.3.0",
  "description": "Nuxt module: render TIFFs via @nuxt/image off the main thread in a Service Worker.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "@nuxt/image",
    "image",
    "tiff",
    "geotiff",
    "webp",
    "service-worker",
    "transcode"
  ],
  "author": "San Chen <bigsan.chen@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigsan/nuxt-tiff-provider.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://github.com/bigsan/nuxt-tiff-provider/tree/main/packages/nuxt#readme",
  "bugs": "https://github.com/bigsan/nuxt-tiff-provider/issues",
  "type": "module",
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@nuxt/image": "^1.11.0",
    "@nuxt/kit": "^4.0.0",
    "@tiff-provider/core": "workspace:*",
    "defu": "^6.1.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.0.0",
    "@nuxt/test-utils": "^3.14.0",
    "@types/node": "^22",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
